{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kenshou run plan v1",
  "type": "object",
  "required": ["schema", "planId", "createdAt", "graphDigest", "cohort", "inputs", "policy", "changes", "runs", "skipped", "warnings", "estimateMinutes"],
  "properties": {
    "schema": {"const": "kenshou.run-plan/v1"},
    "planId": {"type": "string", "format": "uuid"},
    "createdAt": {"type": "string", "format": "date-time"},
    "suite": {"type": ["string", "null"]},
    "graphDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cohort": {
      "type": "object",
      "required": ["name", "planHash"],
      "properties": {"name": {"type": "string"}, "planHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
      "additionalProperties": false
    },
    "inputs": {"type": "object"},
    "policy": {"type": "object", "required": ["maxTier", "kinds", "placement", "dimensionPolicy", "knobPolicy", "trials", "seed"]},
    "changes": {"type": "array", "items": {"type": "object", "required": ["component", "source", "detail"], "properties": {"source": {"$ref": "#/$defs/changeSource"}}}},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
    "skipped": {"type": "array", "items": {"type": "object", "required": ["scenario", "reason", "detail"]}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "estimateMinutes": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "changeSource": {"enum": ["named", "cohort-diff", "since", "upstream-diff", "all", "owner-reproduction"]},
    "reason": {
      "type": "object",
      "required": ["component", "source", "via", "selector", "distance"],
      "properties": {
        "component": {"type": "string"},
        "source": {"$ref": "#/$defs/changeSource"},
        "via": {"type": "array", "items": {"type": "string"}},
        "selector": {"type": "string"},
        "distance": {"type": "integer", "minimum": 0},
        "detail": {"type": "string"}
      },
      "if": {"properties": {"source": {"const": "owner-reproduction"}}},
      "then": {"required": ["detail"]}
    },
    "run": {
      "type": "object",
      "required": ["ordinal", "runId", "estimateMinutes", "reasons", "trial", "spec"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "runId": {"type": "string", "format": "uuid"},
        "estimateMinutes": {"type": "integer", "minimum": 0},
        "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reason"}},
        "trial": {"type": ["object", "null"]},
        "spec": {"$ref": "run-spec-v1.schema.json"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
