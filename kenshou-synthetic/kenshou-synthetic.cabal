cabal-version: 3.0
name: kenshou-synthetic
version: 0.1.0.0
synopsis: Synthetic reference suite and the standalone kenshou executable
description:
  The kenshou executable assembled from the generic operator commands and the
  harness's own self-test bundles.

license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Synthetic
    Kenshou.Suite.Synthetic.Correctness
    Kenshou.Suite.Synthetic.Knobs
    Kenshou.Suite.Synthetic.Oracle
    Kenshou.Suite.Synthetic.Roles
    Kenshou.Suite.Synthetic.Schema
    Kenshou.Suite.Synthetic.Table

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    containers >=0.7 && <0.8,
    hasql >=1.10 && <1.11,
    kenshou-check,
    kenshou-cli,
    kenshou-core,
    pg-migrate,
    scientific,
    stm,
    text >=2.1 && <2.2,
    time,

executable kenshou
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-T

  build-depends:
    base >=4.21 && <4.22,
    kenshou-cli,
    kenshou-synthetic,
