cabal-version: 3.0
name: kenshou-synthetic
version: 0.1.0.0
synopsis: Synthetic reference suite and the standalone kenshou executable
description:
  The kenshou executable assembled from the generic operator commands and the
  harness's own self-test bundles.

license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/kenshou
bug-reports: https://github.com/shinzui/kenshou/issues
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
extra-source-files: data/components.json
tested-with: ghc >=9.12 && <9.13

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Suite.Synthetic
    Kenshou.Suite.Synthetic.Bench
    Kenshou.Suite.Synthetic.Concurrency
    Kenshou.Suite.Synthetic.Correctness
    Kenshou.Suite.Synthetic.Echo
    Kenshou.Suite.Synthetic.Knobs
    Kenshou.Suite.Synthetic.Oracle
    Kenshou.Suite.Synthetic.Roles
    Kenshou.Suite.Synthetic.Schema
    Kenshou.Suite.Synthetic.Table

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    file-embed >=0.0.16 && <0.1,
    hasql >=1.10 && <1.11,
    kenshou-check ^>=0.1.0.0,
    kenshou-cli ^>=0.1.0.0,
    kenshou-core ^>=0.1.0.0,
    kenshou-diagnose ^>=0.1.0.0,
    kenshou-measure ^>=0.1.0.0,
    network >=3.2 && <3.3,
    pg-migrate >=1.1 && <1.2,
    scientific >=0.3 && <0.4,
    stm >=2.5 && <2.6,
    text >=2.1 && <2.2,
    time >=1.14 && <1.15,

executable kenshou
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-T

  build-depends:
    base >=4.21 && <4.22,
    kenshou-cli ^>=0.1.0.0,
    kenshou-synthetic,

source-repository head
  type: git
  location: https://github.com/shinzui/kenshou.git
