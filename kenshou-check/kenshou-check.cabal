cabal-version: 3.0
name: kenshou-check
version: 0.1.0.0
synopsis: Correctness and fault-injection toolkit for Kenshou scenarios
description: Bounded evidence ledgers, invariant verdicts, process supervision, fault injection, and model checking.
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/kenshou
bug-reports: https://github.com/shinzui/kenshou/issues
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  test/golden/verdict.json

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Check.Fact
    Kenshou.Check.Fault
    Kenshou.Check.Fault.Cell
    Kenshou.Check.Fault.Network
    Kenshou.Check.Fault.Postgres
    Kenshou.Check.Fault.Time
    Kenshou.Check.Fault.Wake
    Kenshou.Check.Invariant
    Kenshou.Check.Invariant.Checkpoint
    Kenshou.Check.Invariant.Duplicates
    Kenshou.Check.Invariant.Effects
    Kenshou.Check.Invariant.Gapless
    Kenshou.Check.Invariant.NoLoss
    Kenshou.Check.Invariant.Order
    Kenshou.Check.Invariant.Ownership
    Kenshou.Check.Invariant.Quiescence
    Kenshou.Check.Ledger
    Kenshou.Check.Ledger.Read
    Kenshou.Check.Ledger.Sort
    Kenshou.Check.Model
    Kenshou.Check.Model.Linearizability
    Kenshou.Check.Oracle
    Kenshou.Check.Process
    Kenshou.Check.Scenario
    Kenshou.Check.Selftest
    Kenshou.Check.Selftest.BackendKill
    Kenshou.Check.Selftest.KillRestart
    Kenshou.Check.Selftest.ModelReplay
    Kenshou.Check.Selftest.ProxyPartition
    Kenshou.Check.Verdict
    Kenshou.Check.Window

  build-depends:
    aeson >=2.2 && <2.3,
    async >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    hedgehog >=1.7 && <1.8,
    kenshou-core ^>=0.1.0.0,
    network >=3.2 && <3.3,
    process >=1.6 && <1.7,
    scientific >=0.3 && <0.4,
    splitmix >=0.1 && <0.2,
    stm >=2.5 && <2.6,
    text >=2.1 && <2.2,
    time >=1.14 && <1.15,
    unix >=2.8 && <2.9,

test-suite kenshou-check-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-tool-depends: kenshou-check:kenshou-check-fixture-worker
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-T

  build-depends:
    aeson,
    base >=4.21 && <4.22,
    bytestring,
    containers,
    directory >=1.3 && <1.4,
    filepath,
    hedgehog >=1.4 && <1.8,
    hspec >=2.11 && <2.12,
    hspec-hedgehog >=0.0 && <0.4,
    kenshou-check,
    kenshou-core ^>=0.1.0.0,
    temporary,
    text,
    time >=1.14 && <1.15,

executable kenshou-check-fixture-worker
  import: warnings
  hs-source-dirs: fixture
  main-is: Main.hs
  ghc-options: -threaded
  build-depends:
    base >=4.21 && <4.22

source-repository head
  type: git
  location: https://github.com/shinzui/kenshou.git
