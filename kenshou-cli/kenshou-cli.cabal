cabal-version: 3.0
name: kenshou-cli
version: 0.1.0.0
synopsis: Operator command library for the Kenshou verification harness
description: Operator and automation interface for the Kenshou verification harness.
license: BSD-3-Clause
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  help/*.md
  test/fixtures/*.json

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Cli
    Kenshou.Cli.Attest
    Kenshou.Cli.Cohort
    Kenshou.Cli.Command.Cell
    Kenshou.Cli.Command.Cohort
    Kenshou.Cli.Command.Execute
    Kenshou.Cli.Command.List
    Kenshou.Cli.Command.Overhead
    Kenshou.Cli.Command.Perf
    Kenshou.Cli.Command.Perf.Session
    Kenshou.Cli.Command.Plan
    Kenshou.Cli.Command.Run
    Kenshou.Cli.Command.Worker
    Kenshou.Cli.Completions
    Kenshou.Cli.Config
    Kenshou.Cli.Diagnose
    Kenshou.Cli.Help
    Kenshou.Cli.Help.Width
    Kenshou.Cli.Main
    Kenshou.Cli.Options
    Kenshou.Cli.Registry
    Kenshou.Cli.Version

  other-modules: Paths_kenshou_cli
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory,
    file-embed >=0.0.16 && <0.1,
    filepath >=1.5 && <1.6,
    githash >=0.1.7 && <0.2,
    hasql >=1.10 && <1.11,
    kenshou-check,
    kenshou-core,
    kenshou-diagnose,
    kenshou-evidence,
    kenshou-measure,
    kenshou-remote,
    kenshou-telemetry,
    optparse-applicative >=0.19 && <0.20,
    process >=1.6 && <1.7,
    random >=1.2.1 && <1.4,
    settei ^>=0.2.0.0,
    settei-env ^>=0.2.0.0,
    settei-optparse-applicative ^>=0.2.0.0,
    temporary,
    terminal-size >=0.3.4 && <0.4,
    text >=2.1 && <2.2,
    time,
    uuid,

test-suite kenshou-cli-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: PerfSessionSpec
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring,
    containers >=0.7 && <0.8,
    directory,
    filepath,
    hspec >=2.11 && <2.12,
    kenshou-cli,
    kenshou-core,
    kenshou-measure,
    kenshou-remote,
    kenshou-telemetry,
    temporary,
    text >=2.1 && <2.2,
    time,
    uuid,
