cabal-version: 3.0
name: kenshou-evidence
version: 0.1.2.0
synopsis: Historic verification records and durable object storage
description: Evidence types and storage boundaries for Kenshou run records.
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/kenshou
bug-reports: https://github.com/shinzui/kenshou/issues
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  test/fixtures/attestation/computations/*.md
  test/fixtures/attestation/index.md
  test/fixtures/attestation/profile.dhall
  test/fixtures/attestation/references/attesters/*.sh
  test/fixtures/attestation/references/executors/*.sh
  test/fixtures/consumer-records/*.json
  test/fixtures/consumer-records/*.md
  test/fixtures/consumer-records/SOURCE
  test/fixtures/dispositions/*.json
  test/fixtures/owners/*.json
  test/fixtures/owners/owner-a/bug-reports/*.md
  test/fixtures/owners/owner-b/bug-reports/*.md
  test/fixtures/profile-invalid/*.json
  test/fixtures/reconcile/*.json
  test/fixtures/reconcile/owners/owner-a/bug-reports/*.md
  test/fixtures/reconcile/owners/owner-b/bug-reports/*.md
  test/fixtures/reconcile/owners/owner-d/bug-reports/*.md
  test/fixtures/reconcile/snapshot/records/164a1c744b2bef638226ce44ad3a61bd6704678f7fbafca6fe319b2feffa3ebd
  test/fixtures/reconcile/snapshot/records/765e3f5368b24ad8c6b3b390398b007ca66cb47df817c2c8b6687876a98da4fc
  test/fixtures/reconcile/snapshot/records/8a4ca3cbc74e8ed7c6783e06a785bbc5dfc2a263c1272e560f1ba85305bcfc3b
  test/fixtures/reconcile/snapshot/records/8f1960653afcd84f973a172685aa9a6067f8ca0f0e1897ecdb0dcf31d0ccf2d2
  test/fixtures/reconcile/snapshot/records/a0eb863f03573405833f41098ed9896f47165efebe6ab4d934469457ee46f6cd
  test/fixtures/reconcile/snapshot/records/bcf4faf512e1bff0c04d37a30a9c888ed347ca514bcfc12fd08324a6fa912d40
  test/fixtures/reconcile/snapshot/records/c3b5d0e38026bb78a0c49695d0108b51d7c535ce65926c3253bcd2d84cc030eb
  test/fixtures/reconcile/snapshot/records/e45e1d47d8901c30b7ac524faea0180c3fb8d2765932367ff591462ca2e486f8
  test/fixtures/reconcile/snapshot/records/ec946fc793e4861717ccb282d9ea0260cf2c64b506ce96515bb77d553b1daa1f
  test/fixtures/reconcile/snapshot/records/f0d1088d68b4cb3a453910c7abe5d4cb0810203506aae50ba3034bc3382b88e8
  test/fixtures/reconcile/snapshot/records/fca589e186bd40d17868db176d5d2c488f982a579a75a0bd5651ff1045072b77
  test/fixtures/reconcile/snapshot/snapshot.json

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Evidence.Attest
    Kenshou.Evidence.Bundle
    Kenshou.Evidence.Check
    Kenshou.Evidence.Cli
    Kenshou.Evidence.Config
    Kenshou.Evidence.Disposition
    Kenshou.Evidence.Frontmatter
    Kenshou.Evidence.History
    Kenshou.Evidence.HistoryCli
    Kenshou.Evidence.Observation
    Kenshou.Evidence.Owner
    Kenshou.Evidence.Owner.Cli
    Kenshou.Evidence.Owner.Reconcile
    Kenshou.Evidence.Owner.Record
    Kenshou.Evidence.Owner.Resolver
    Kenshou.Evidence.Owner.Snapshot
    Kenshou.Evidence.Publish
    Kenshou.Evidence.Record
    Kenshou.Evidence.Source
    Kenshou.Evidence.Store
    Kenshou.Evidence.Types

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    kenshou-core ^>=0.1.1.0,
    kenshou-remote ^>=0.1.0.0,
    okf-core ^>=0.9.0.0,
    optparse-applicative >=0.19 && <0.20,
    process >=1.6 && <1.7,
    settei ^>=0.2.0.0,
    settei-env ^>=0.2.0.0,
    settei-optparse-applicative ^>=0.2.0.0,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.2,
    time >=1.14 && <1.15,
    transformers >=0.6 && <0.7,
    unix >=2.8 && <2.9,
    vector >=0.13 && <0.14,

test-suite kenshou-evidence-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    DispositionSpec
    OwnerSpec
    ReconcileSpec

  build-depends:
    aeson,
    base >=4.21 && <4.22,
    bytestring,
    containers,
    directory >=1.3 && <1.4,
    filepath,
    hedgehog >=1.4 && <1.8,
    hspec >=2.11 && <2.12,
    hspec-hedgehog >=0.0 && <0.4,
    kenshou-core ^>=0.1.1.0,
    kenshou-evidence,
    kenshou-remote ^>=0.1.0.0,
    okf-core,
    process >=1.6 && <1.7,
    settei,
    settei-env,
    settei-optparse-applicative,
    temporary >=1.3 && <1.4,
    text,
    time >=1.14 && <1.15,

source-repository head
  type: git
  location: https://github.com/shinzui/kenshou.git
