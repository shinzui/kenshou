cabal-version: 3.0
name: kenshou-evidence
version: 0.1.0.0
synopsis: Historic verification records and durable object storage
description: Evidence types and storage boundaries for Kenshou run records.
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/kenshou
bug-reports: https://github.com/shinzui/kenshou/issues
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  test/fixtures/consumer-records/*.json
  test/fixtures/consumer-records/*.md
  test/fixtures/consumer-records/SOURCE
  test/fixtures/profile-invalid/*.json

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Evidence.Attest
    Kenshou.Evidence.Bundle
    Kenshou.Evidence.Check
    Kenshou.Evidence.Cli
    Kenshou.Evidence.Config
    Kenshou.Evidence.Frontmatter
    Kenshou.Evidence.History
    Kenshou.Evidence.HistoryCli
    Kenshou.Evidence.Publish
    Kenshou.Evidence.Record
    Kenshou.Evidence.Source
    Kenshou.Evidence.Store
    Kenshou.Evidence.Types

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    kenshou-core ^>=0.1.0.0,
    kenshou-remote ^>=0.1.0.0,
    okf-core ^>=0.9.0.0,
    optparse-applicative >=0.19 && <0.20,
    process >=1.6 && <1.7,
    settei ^>=0.2.0.0,
    settei-env ^>=0.2.0.0,
    settei-optparse-applicative ^>=0.2.0.0,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.2,
    time >=1.14 && <1.15,
    transformers >=0.6 && <0.7,
    unix >=2.8 && <2.9,

test-suite kenshou-evidence-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    aeson,
    base >=4.21 && <4.22,
    bytestring,
    containers,
    directory >=1.3 && <1.4,
    filepath,
    hspec >=2.11 && <2.12,
    kenshou-core ^>=0.1.0.0,
    kenshou-evidence,
    kenshou-remote ^>=0.1.0.0,
    okf-core,
    process >=1.6 && <1.7,
    settei,
    settei-env,
    settei-optparse-applicative,
    temporary >=1.3 && <1.4,
    text,
    time >=1.14 && <1.15,

source-repository head
  type: git
  location: https://github.com/shinzui/kenshou.git
