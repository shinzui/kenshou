cabal-version: 3.0
name: kenshou-remote
version: 0.1.0.0
synopsis: Leased verification cell client and storage protocol
description: Leases verification cells, publishes immutable run payloads, submits and recovers cell runs, and stores evidence objects in files or Google Cloud Storage.
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/kenshou
bug-reports: https://github.com/shinzui/kenshou/issues
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  test/golden/*.json
  test/golden/cell/*.json
  test/golden/cell/SOURCE

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveGeneric
    DuplicateRecordFields
    ImportQualifiedPost
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Remote.Cell.Control
    Kenshou.Remote.Cell.Debug
    Kenshou.Remote.Cell.Docs
    Kenshou.Remote.Cell.Exec
    Kenshou.Remote.Cell.Fetch
    Kenshou.Remote.Cell.Health
    Kenshou.Remote.Cell.Index
    Kenshou.Remote.Cell.Lease
    Kenshou.Remote.Cell.Legacy
    Kenshou.Remote.Cell.Parity
    Kenshou.Remote.Cell.Prepare
    Kenshou.Remote.Cell.RouteJson
    Kenshou.Remote.Cell.RouteRules
    Kenshou.Remote.Cell.Session
    Kenshou.Remote.Cell.Session.Build
    Kenshou.Remote.Cell.Session.Journal
    Kenshou.Remote.Cell.Session.Rebind
    Kenshou.Remote.Cell.Session.Resume
    Kenshou.Remote.Cell.Session.Runner
    Kenshou.Remote.Cell.Submit
    Kenshou.Remote.Cell.Watch
    Kenshou.Remote.Cell.WorkJson
    Kenshou.Remote.Pair
    Kenshou.Remote.Payload
    Kenshou.Remote.Payload.Nix
    Kenshou.Remote.Payload.Publish
    Kenshou.Remote.Payload.Publisher
    Kenshou.Remote.Perf.Attempt
    Kenshou.Remote.Perf.Cell
    Kenshou.Remote.Perf.Cleanup
    Kenshou.Remote.Perf.Conditions
    Kenshou.Remote.Perf.Journal
    Kenshou.Remote.Perf.Lock
    Kenshou.Remote.Perf.Publication
    Kenshou.Remote.Perf.Runner
    Kenshou.Remote.Selftest
    Kenshou.Remote.Store
    Kenshou.Remote.Store.File
    Kenshou.Remote.Store.Gcs

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    base16-bytestring >=1.0 && <1.1,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    cryptohash-sha256 >=0.11 && <0.12,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.4 && <0.5,
    http-types >=0.12 && <0.13,
    kenshou-core ^>=0.1.0.0,
    kenshou-measure ^>=0.1.0.0,
    network >=3.2 && <3.3,
    process >=1.6 && <1.7,
    text >=2.1 && <2.2,
    time >=1.14 && <1.15,
    unix >=2.8 && <2.9,

test-suite kenshou-remote-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    DebugSpec
    DocsSpec
    ExecSpec
    FetchSpec
    GcsSpec
    HealthSpec
    LeaseSpec
    PairSpec
    ParitySpec
    PayloadSpec
    PerfAttemptSpec
    PerfCellSpec
    PerfCleanupSpec
    PerfConditionsSpec
    PerfJournalSpec
    PerfLockSpec
    PerfPublicationSpec
    PerfRunnerSpec
    PrepareSpec
    SessionSpec
    SubmitSpec
    WatchSpec

  build-depends:
    aeson,
    base >=4.21 && <4.22,
    bytestring,
    containers >=0.7 && <0.8,
    directory >=1.3 && <1.4,
    filepath,
    hspec >=2.11 && <2.12,
    kenshou-core ^>=0.1.0.0,
    kenshou-measure ^>=0.1.0.0,
    kenshou-remote,
    network >=3.2 && <3.3,
    process >=1.6 && <1.7,
    temporary,
    text,
    time >=1.14 && <1.15,

source-repository head
  type: git
  location: https://github.com/shinzui/kenshou.git
