cabal-version: 3.0
name: kenshou-core
version: 0.1.0.0
synopsis: Scenario kernel and protocol for the Kenshou verification harness
description: Shared contracts and utilities for the Kenshou verification harness.
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/kenshou
bug-reports: https://github.com/shinzui/kenshou/issues
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  data/components.json
  test/fixtures/*.json
  test/fixtures/invalid-project/cohort/*.project
  test/fixtures/perf/*.json
  test/fixtures/plan/*.json
  test/fixtures/valid-project/cohort/*.project
  test/golden/*.json
  test/golden/*.jsonl
  test/golden/resources/*.json

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Core.Bundle
    Kenshou.Core.Canonical
    Kenshou.Core.Cli
    Kenshou.Core.Cli.Config
    Kenshou.Core.Cohort
    Kenshou.Core.Compat
    Kenshou.Core.Context
    Kenshou.Core.Contribution
    Kenshou.Core.Dimension
    Kenshou.Core.Env
    Kenshou.Core.Env.Migration
    Kenshou.Core.Env.Postgres
    Kenshou.Core.Fingerprint
    Kenshou.Core.Id
    Kenshou.Core.Knob
    Kenshou.Core.Log
    Kenshou.Core.Manifest
    Kenshou.Core.Outcome
    Kenshou.Core.Phase
    Kenshou.Core.Resource
    Kenshou.Core.Resource.Types
    Kenshou.Core.Role
    Kenshou.Core.Role.Dispatch
    Kenshou.Core.Role.Spawn
    Kenshou.Core.Run
    Kenshou.Core.RunResult
    Kenshou.Core.RunSpec
    Kenshou.Core.RunSpec.Resolve
    Kenshou.Core.Scenario
    Kenshou.Core.Selector
    Kenshou.Core.Selftest
    Kenshou.Core.Selftest.Schema
    Kenshou.Core.Version
    Kenshou.Perf.Artifacts
    Kenshou.Perf.Calibration
    Kenshou.Perf.Contracts
    Kenshou.Perf.Plan
    Kenshou.Perf.Prepared
    Kenshou.Perf.Request
    Kenshou.Perf.Result
    Kenshou.Perf.Source
    Kenshou.Plan.Catalog
    Kenshou.Plan.Change
    Kenshou.Plan.Change.Cohort
    Kenshou.Plan.Change.Git
    Kenshou.Plan.Components
    Kenshou.Plan.Components.Check
    Kenshou.Plan.Execute
    Kenshou.Plan.Matrix
    Kenshou.Plan.Policy
    Kenshou.Plan.RunPlan
    Kenshou.Plan.Selector
    Kenshou.Plan.Suite
    Kenshou.Plan.Summary

  other-modules: Paths_kenshou_core
  autogen-modules: Paths_kenshou_core
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    base16-bytestring >=1.0 && <1.1,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    cryptohash-sha256 >=0.11 && <0.12,
    directory >=1.3 && <1.4,
    ephemeral-pg >=0.3.1 && <0.4,
    file-embed >=0.0.16 && <0.1,
    filepath >=1.5 && <1.6,
    hasql >=1.10 && <1.11,
    mmzk-typeid >=0.7 && <0.8,
    optparse-applicative >=0.19 && <0.20,
    pg-migrate ^>=1.1.0.0 || ^>=1.2.0.0,
    process >=1.6 && <1.7,
    random >=1.2.1 && <1.4,
    scientific >=0.3 && <0.4,
    settei ^>=0.2.0.0,
    settei-optparse-applicative ^>=0.2.0.0,
    settei-yaml ^>=0.2.0.0,
    splitmix >=0.1 && <0.2,
    text >=2.1 && <2.2,
    time >=1.14 && <1.15,
    unix >=2.8 && <2.9,
    uuid >=1.3 && <1.4,
    vector >=0.13 && <0.14,

test-suite kenshou-core-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Kenshou.ConsumerBaseline
    Kenshou.PerfCalibrationSpec
    Kenshou.PerfPreparedSpec
    Kenshou.PerfResultSpec
    Kenshou.PerfSpec
    Kenshou.PlanSpec
    Kenshou.ResourceSpec

  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring,
    containers,
    directory >=1.3 && <1.4,
    filepath,
    hedgehog >=1.4 && <1.8,
    hspec >=2.11 && <2.12,
    hspec-hedgehog >=0.0 && <0.4,
    kenshou-core,
    pg-migrate,
    process >=1.6 && <1.7,
    temporary,
    text >=2.1 && <2.2,
    time >=1.14 && <1.15,

source-repository head
  type: git
  location: https://github.com/shinzui/kenshou.git
